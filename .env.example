# ─────────────────────────────────────────────
# 사이트 주소
# ─────────────────────────────────────────────
# canonical / sitemap.xml / robots.txt / OG 태그 / JSON-LD 에 사용됩니다.
# 끝에 슬래시는 붙이지 않아도 됩니다.
#   예) https://certoagency.com
#   예) https://certo-agency.<계정>.workers.dev   (도메인 연결 전 임시)
NEXT_PUBLIC_SITE_URL=https://www.certoagency.com


# ─────────────────────────────────────────────
# 문의 알림  (운영 전 반드시 설정)
# ─────────────────────────────────────────────
# 상담 문의 수신 주소는 기본값(yorkboy@gmail.com)이 코드에 들어 있습니다.
# 따라서 아래 RESEND_API_KEY 하나만 등록하면 메일이 발송됩니다.
# 설정하지 않으면 문의가 서버 로그에만 남고 사라집니다.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# 수신 주소를 바꾸거나 여러 명에게 보낼 때만 설정합니다. (쉼표로 구분)
# INQUIRY_TO_EMAIL=yorkboy@gmail.com,manager@certoagency.com

# 발신 주소. 기본값은 onboarding@resend.dev 이며 도메인 인증 없이 쓸 수 있습니다.
# 다만 도메인 인증 전에는 "Resend 가입에 사용한 이메일" 로만 발송됩니다.
#   → 문의를 받을 주소(yorkboy@gmail.com)로 Resend 에 가입하면 추가 설정이 필요 없습니다.
# 회사 도메인을 Resend 에 인증한 뒤에만 아래를 설정하세요.
# INQUIRY_FROM_EMAIL=CERTO AGENCY <noreply@certoagency.com>

# Slack 즉시 알림 (선택)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ


# ─────────────────────────────────────────────
# 분석  (선택)
# ─────────────────────────────────────────────
# Cloudflare Web Analytics — 무료, 쿠키 미사용(동의 배너 불필요), 페이지뷰 전용
# NEXT_PUBLIC_CF_BEACON_TOKEN=xxxxxxxxxxxxxxxx

# GA4 — CTA 클릭을 이벤트(cta_click)로 수집하려면 이쪽이 필요합니다.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX


# ─────────────────────────────────────────────
# 이미지  (선택)
# ─────────────────────────────────────────────
# Cloudflare Workers 배포 + 실사 사진(.jpg/.png) 사용 + Cloudflare Images 미사용일 때만 true
# NEXT_IMAGE_UNOPTIMIZED=true
