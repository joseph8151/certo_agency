# 사이트 절대 주소 — canonical / sitemap.xml / OG 태그 / JSON-LD 에 사용됩니다.
# 배포 도메인으로 설정하세요. 끝에 슬래시는 붙이지 않아도 됩니다.
#   예) https://certoagency.com
#   예) https://certo-agency.<계정>.workers.dev   (도메인 연결 전 임시)
NEXT_PUBLIC_SITE_URL=https://www.certoagency.com

# Cloudflare Workers 배포에서 실사 사진(.jpg/.png)을 쓰는 경우에만 true.
# Cloudflare Images 바인딩을 붙이지 않을 때 이미지 최적화를 끕니다.
# NEXT_IMAGE_UNOPTIMIZED=true
