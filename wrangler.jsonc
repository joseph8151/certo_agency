{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "certo-agency",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  /*
   * 빌드는 여기서 처리하지 않습니다.
   * `wrangler deploy` 는 OpenNext 프로젝트를 감지하면 곧바로
   * `opennextjs-cloudflare deploy` 로 넘어가기 때문에 wrangler 의 build hook 이
   * 실행되지 않습니다. (`--dry-run` 에서는 실행되어 오해하기 쉬운 부분입니다)
   *
   * 따라서 빌드는 반드시 배포 전에 별도로 수행되어야 합니다.
   *   로컬        → npm run cf:deploy  (빌드 후 배포)
   *   Cloudflare  → 대시보드 Build command 에 `npm run cf:build`
   */

  "observability": {
    "enabled": true
  }
}
